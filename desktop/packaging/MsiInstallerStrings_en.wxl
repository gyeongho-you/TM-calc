<?xml version="1.0" encoding="utf-8"?>
<!-- 설치 화면 한글 문구. jpackage 기본 영어 파일(MsiInstallerStrings_en.wxl)을 덮어써서 ko-kr 로 만든다 (따로 ko 파일을 두면 같은 문구가 두 번 들어가 빌드 오류). 나머지 기본 화면 문구는 WiX 기본 한국어 -->
<WixLocalization Culture="ko-kr" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="949">
  <String Id="message.install.dir.exist">[INSTALLDIR] 폴더가 이미 있습니다. 그래도 이 폴더에 설치할까요?</String>
  <String Id="MainFeatureTitle">TM-calc</String>
  <String Id="DowngradeErrorMessage">더 새 버전의 [ProductName] 이(가) 이미 설치되어 있습니다. 설치를 끝냅니다.</String>
  <String Id="DisallowUpgradeErrorMessage">이전 버전의 [ProductName] 이(가) 설치되어 있어 설치할 수 없습니다. 설치를 끝냅니다.</String>

  <String Id="ShortcutPromptDlg_Title">[ProductName] 설치</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}바로 가기</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">만들 바로 가기를 고르세요.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">바탕 화면 바로 가기 만들기</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">시작 메뉴 바로 가기 만들기</String>
  <String Id="InstallDirNotEmptyDlg_Title">[ProductName] 설치</String>
  <String Id="ContextMenuCommandLabel">[ProductName] (으)로 열기</String>
</WixLocalization>
